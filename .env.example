BOT_TOKEN=your_bot_token_here
DASHBOARD_USER=admin
DASHBOARD_PASS=admin@linkgroup
# Optional: secret for signing login tokens (defaults to hash of user+pass)
# DASHBOARD_SECRET=change-me-to-a-long-random-string
# DASHBOARD_TOKEN_DAYS=30
DATABASE_URL=postgresql://user:pass@host:5432/dbname
TZ_OFFSET=7
# Comma-separated Telegram chat IDs to forward reports to (groups, channels, users)
# Use -100xxxxxxxxxx format for channels/supergroups
# FORWARD_CHAT_IDS=-1001234567890,-1009876543210
# Chat ID to forward reports to when using /forward (group ID or user ID)
FORWARD_CHAT_ID=
